# vim: ft=tmux

# split the code window and start vim
rename-window -t :0 code
split-window -h -t :0
send-keys -t :0 'vim .' Enter

# create server window and start services
new-window -a -d -n servers -t :
split-window -h -t :1
split-window -h -t :1
send-keys -t :1.0 './bin/static_server' Enter
send-keys -t :1.1 './bin/build_site' Enter
send-keys -t :1.2 './bin/watch_notes' Enter

# go back to code window
select-window -t :0
